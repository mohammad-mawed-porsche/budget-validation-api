HOST=0.0.0.0
PORT=3100
LOG_LEVEL=info
DEPLOY_ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Self-managed users. Generate a hash with:
# npm run auth:hash-password -- 'your password'
AUTH_MODE=local-users
AUTH_USERS_JSON=[{"username":"admin","passwordHash":"$argon2id$REPLACE_ME","roles":["admin","operator","viewer"]}]
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_ISSUER=budget-validation-api
AUTH_AUDIENCE=budget-validation-clients
AUTH_ACCESS_TTL_SECONDS=900
AUTH_IDLE_TTL_SECONDS=1800
AUTH_ABSOLUTE_TTL_SECONDS=43200
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_COOKIE_NAME=budget_refresh
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_DOMAIN=example.com

PRODUCTIVE_BASE_URL=https://api.productive.io/api/v2
PRODUCTIVE_API_KEY=
PRODUCTIVE_ORG_ID=
PRODUCTIVE_COST_CENTER_FIELD_ID=17450
PRODUCTIVE_PAGE_SIZE=200
PRODUCTIVE_MAX_PAGES_PER_COST_ID=5
PRODUCTIVE_MAX_CONCURRENCY=5
PRODUCTIVE_MIN_REQUEST_INTERVAL_MS=125
WORKFLOW_TIMEZONE=Europe/Berlin

MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/YOUR_TENANT/oauth2/v2.0/token
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SCOPE=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
HEIMDALL_SITE_ID=
HEIMDALL_LIST_ID=
HEIMDALL_MAX_LIST_PAGES=20
HEIMDALL_BUDGET_VALID_TRUE_VALUE=True
HEIMDALL_BUDGET_VALID_FALSE_VALUE=False

REQUEST_TIMEOUT_MS=15000
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RETRY_BASE_MS=500
STORAGE_FILE=.data/workflow-store.json
AUTH_STORE_FILE=.data/auth-store.json
STORAGE_DRIVER=file
# DYNAMODB_TABLE_NAME=budget-validation-state
# WORKFLOW_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/ACCOUNT/queue
# SSM_PARAMETER_PREFIX=/budget-validation/prod
AWS_REGION=eu-central-1
MAX_STORED_RUNS=200
MAX_STORED_NOTIFICATIONS=5000
NOTIFICATION_COOLDOWN_DAYS=7
SLACK_NOTIFICATIONS_ENABLED=false
# Store the production value in SSM SecureString; use this only for local development.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME
SCHEDULER_POLL_INTERVAL_MS=30000
LOCAL_SCHEDULER_ENABLED=true
RUN_LOCK_TTL_SECONDS=21600
SCHEDULED_RUN_SCOPE=all
SCHEDULED_RUN_DRY_RUN=false
